CS_APP_NAME=Company Screener API
CS_ENVIRONMENT=development
CS_API_V1_PREFIX=/api/v1
CS_INDEX_DIR=E:\company-screener\search_index_exact
CS_LISTS_DIR=E:\company-screener\lists
CS_SEARCH_HISTORY_PATH=E:\company-screener\search_history.json
CS_INDEX_JOBS_DIR=E:\company-screener\index_jobs
CS_INDEX_BUNDLES_DIR=E:\company-screener\index_bundles
CS_INDEX_UPLOADS_DIR=E:\company-screener\index_uploads
